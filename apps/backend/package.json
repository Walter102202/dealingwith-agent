{
  "name": "@dealingwith/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "DealingWith Agent backend: JSON API, MCP endpoint, PayPal webhooks and static web.",
  "scripts": {
    "dev": "tsx watch --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=development src/db/migrate-cli.ts",
    "seed": "tsx --conditions=development src/db/seed-cli.ts",
    "mcp:smoke": "node scripts/mcp-smoke.mjs"
  },
  "dependencies": {
    "@dealingwith/contracts": "workspace:*",
    "@electric-sql/pglite": "^0.5.15",
    "@hono/mcp": "0.3.5",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.17",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
