# Web client (Vite). Copy to apps/web/.env for local overrides; nothing here is secret.

# fixtures: in-memory demo API inside the browser (tests and offline demos).
# http: proxy /api, /mcp, /mock-paypal and /healthz to the backend below.
VITE_API_MODE=http

# Backend the dev server proxies to (the plan's preflight runs the API on 3001).
VITE_API_PROXY=http://localhost:3001

# AG Studio license key for the provider dashboard. Empty = trial mode with a watermark.
# Needed at build time (Vite inlines it), so set it in the Render build environment too.
VITE_AG_STUDIO_LICENSE=
