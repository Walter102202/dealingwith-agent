{
  "name": "dealingwith-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Turn service requests into paid work. AI agent that quotes and gets paid with PayPal, for humans (web) and agents (MCP).",
  "license": "MIT",
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "build": "pnpm -r --if-present build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "eval:live": "pnpm --filter @dealingwith/evals exec tsx --conditions=development live/run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
