# Copy to .env and adjust. Every value below is a mock default: the product runs
# locally with no credentials. Never commit a real key.

# Database. pglite://<dir> = embedded PostgreSQL persisted in <dir>;
# pglite://memory = in-memory; postgres://... = a real PostgreSQL (Render).
DATABASE_URL=pglite://.data/dev

# PayPal. mock = local gateway with its own approve page; sandbox = real REST
# calls (phase 2 only). Live mode does not exist in this codebase.
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Shared secret the mock gateway signs its emitted webhooks with.
MOCK_WEBHOOK_SECRET=mock-webhook-secret

# LLM. mock = fixture outputs used by the scenario tests.
LLM_PROVIDER=mock
# Defaults when empty: claude-opus-5-5 (anthropic), gpt-5 (openai).
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# App
APP_URL=http://localhost:3000
PORT=3000
SESSION_SECRET=dev-session-secret-change-me
DEMO_MODE=true

# Web client (Vite, build time). Full comments in apps/web/.env.example.
# fixtures = in-browser demo API; http = proxy /api to VITE_API_PROXY.
VITE_API_MODE=http
VITE_API_PROXY=http://localhost:3000
# AG Studio license. Empty = trial mode with a watermark.
VITE_AG_STUDIO_LICENSE=
